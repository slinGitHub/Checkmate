<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->

    <!-- Bright Theme -->
    <style name="AppTheme_bright" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor" tools:targetApi="l">#EEF0F3</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="colorActionBarCheckmate">#EEF0F3</item>
        <item name="android:windowSplashScreenBackground">#EEF0F3</item>

        <item name="popupTheme">@style/ThemeOverlay.AppCompat.Light</item>
        <item name="android:textColorSecondary">#012D37</item>
        <item name="colorControlNormal">#012D37</item>

        <item name="colorTextBubbleBar">#094453</item>
        <item name="colorBackgroundCheckmate">#EEF0F3</item>
        <item name="colorBackgroundCheckmateAvg">#F6F7F9</item>
        <item name="colorBackgroundCheckmateBright">#FFFFFF</item>

        <item name="alphaBarInRangeBackground">255</item>
        <item name="colorBarInRangeBackground">#EEF0F3</item>

<!--    Bubble/Bar Chart Colors -->
        <item name="colorXAxisText">#6F7582</item>

        <item name="colorInRange">#7AD6AE</item>
        <item name="colorOutOfRange">#F6C645</item>
        <item name="colorVeryOutOfRange">#F78F85</item>

        <item name="colorTextInRange">#063B27</item>
        <item name="colorTextOutOfRange">#4B3600</item>
        <item name="colorTextVeryOutOfRange">#5F130C</item>

        <item name="colorGMIline">#6F7582</item>

        <item name="colorNotEnoughData">#AEAEAE</item>

<!--    DayChart -->
        <item name="colorDayLineInRange">#EEF0F3</item>
        <item name="alphaDayLineInRange">255</item>

        <item name="colorDayLine">#012D37</item>

<!--    To Be CHECKED!!-->

        <item name="colorCircle">#eeeeee</item>
        <item name="colorLineDayGraphPerc">#eeeeee</item>
        <item name="colorTextHeading">#6F7582</item>
        <item name="colorSelectedLine">#012D37</item>

    </style>










