<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->

    <!-- Bright Theme -->
    <style name="AppTheme_bright" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor" tools:targetApi="l">#EEF0F3</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="colorActionBarCheckmate">#EEF0F3</item>
        <item name="android:windowSplashScreenBackground">#EEF0F3</item>

        <item name="popupTheme">@style/ThemeOverlay.AppCompat.Light</item>
        <item name="android:textColorSecondary">#012D37</item>
        <item name="colorControlNormal">#012D37</item>

        <item name="colorTextBubbleBar">#094453</item>
        <item name="colorBackgroundCheckmate">#EEF0F3</item>
        <item name="colorBackgroundCheckmateAvg">#F6F7F9</item>
        <item name="colorBackgroundCheckmateBright">#FFFFFF</item>
        <item name="colorSettingsBackground">#EEF0F3</item>

        <item name="alphaBarInRangeBackground">255</item>
        <item name="colorBarInRangeBackground">#EEF0F3</item>

        <!--    Border Colors bg_card-->
        <item name="colorChartBorder">#E5E8ED</item>

        <!--   Selected Entity-->
        <item name="colorSelectedLine">#012D37</item>


<!--    Bubble/Bar Chart Colors -->
        <item name="colorXAxisText">#6F7582</item>

        <item name="colorInRange">#7AD6AE</item>
        <item name="colorOutOfRange">#F6C645</item>
        <item name="colorVeryOutOfRange">#F78F85</item>

        <item name="colorTextInRange">#063B27</item>
        <item name="colorTextOutOfRange">#4B3600</item>
        <item name="colorTextVeryOutOfRange">#5F130C</item>

        <item name="colorGMIline">#6F7582</item>

        <item name="colorNotEnoughData">#AEAEAE</item>

<!--    DayChart -->
        <item name="colorDayLineInRange">#EEF0F3</item>
        <item name="alphaDayLineInRange">255</item>

        <item name="colorRangeLine">#EEF0F3</item>

        <item name="colorDayLine">#012D37</item>


<!--    To Be CHECKED!!-->

        <item name="colorCircle">#eeeeee</item>
        <item name="colorLineDayGraphPerc">#eeeeee</item>
        <item name="colorTextHeading">#6F7582</item>



    </style>

    <!-- Dark Theme -->
    <style name="AppTheme_dark" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor" tools:targetApi="l">#121212</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="colorActionBarCheckmate">#1E1E1E</item>
        <item name="android:windowSplashScreenBackground">#2D2D2D</item>

        <item name="popupTheme">@style/ThemeOverlay.AppCompat.Dark</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#E0E0E0</item>
        <item name="colorControlNormal">#E0E0E0</item>

        <item name="colorTextBubbleBar">#81D4FA</item>
        <item name="colorBackgroundCheckmate">#121212</item>
        <!--    Band Selected Entrys Fill Color-->
        <item name="colorBackgroundCheckmateAvg">#595959</item>
        <item name="colorBackgroundCheckmateBright">#2D2D2D</item>
        <item name="colorSettingsBackground">#2D2D2D</item>

        <item name="alphaBarInRangeBackground">255</item>
        <item name="colorBarInRangeBackground">#404040</item>

        <!--    Border Colors bg_card-->
        <item name="colorChartBorder">#3F3F3F</item>

        <!--   Selected Entity-->
        <item name="colorSelectedLine">#FFFFFF</item>

<!--    Bubble/Bar Chart Colors -->
        <item name="colorXAxisText">#B0BEC5</item>

        <item name="colorInRange">#81C784</item>
        <item name="colorOutOfRange">#FFB74D</item>
        <item name="colorVeryOutOfRange">#E57373</item>

        <item name="colorTextInRange">#063B27</item>
        <item name="colorTextOutOfRange">#4B3600</item>
        <item name="colorTextVeryOutOfRange">#5F130C</item>

        <item name="colorGMIline">#B0BEC5</item>

        <item name="colorNotEnoughData">#757575</item>

<!--    DayChart -->
        <item name="colorDayLineInRange">#595959</item>
        <item name="alphaDayLineInRange">255</item>

        <item name="colorRangeLine">#2D2D2D</item>

        <item name="colorDayLine">#FFFFFF</item>

<!--    To Be CHECKED!!-->

        <item name="colorCircle">#2D2D2D</item>
        <item name="colorLineDayGraphPerc">#424242</item>
        <item name="colorTextHeading">#B0BEC5</item>



    </style>










